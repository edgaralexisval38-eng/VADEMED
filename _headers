# Cloudflare Pages headers
# El service worker y el shell NUNCA se cachean en el navegador: asi las actualizaciones
# llegan siempre en la siguiente recarga (se acaba el problema de "sigue saliendo lo viejo").
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.json
  Cache-Control: no-cache
